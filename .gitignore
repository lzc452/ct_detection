# ============================================================
# CT 缺陷检测系统 .gitignore
# 原则：代码与文档入库；原始数据集、产线图片、模型权重、
#       便携运行环境、训练记录等大文件一律排除。
# ============================================================

# ---------- 原始数据集（数百 GB，绝不入库） ----------
datasets/
积攒/
练兵/
考卷*/
问题电芯图片汇总/

# ---------- 数据闭环产出（收割 / 复核结果，图片量大） ----------
收割结果_*/
复核_*/

# ---------- 大体积 CSV 记录（收割明细，可重新生成） ----------
harvest_*.csv
battlefield_*.csv

# ---------- 模型权重（*.pt 一律不入库） ----------
*.pt
*.onnx
*.engine
*.tflite
weights/
models/pretrained/
models/启用/

# ---------- 训练记录 ----------
runs/

# ---------- 便携 Python 运行环境（~8 GB，严禁入库） ----------
runtime/

# ---------- 第三方工具安装包 ----------
tools/*.exe

# ---------- 运行期产物 ----------
logs/
web/results/
web/uploads/
*.log

# ---------- 汇报材料中的图片/媒体（保留 md 文档，排除媒体） ----------
ppt汇报/media/
ppt汇报/pages/
ppt汇报/screenshots/
ppt汇报_screenshot/
向上汇报/pages/
向上汇报_screenshot/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------- 系统/编辑器 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
