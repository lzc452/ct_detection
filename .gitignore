# ============================================================
# CT 缺陷检测系统 .gitignore
# 原则：代码与文档入库；原始数据集、产线图片、模型权重、
#       便携运行环境、训练记录等大文件一律排除。
# ============================================================

# ---------- 原始数据集（数百 GB，绝不入库） ----------
datasets/
积攒/
练兵/
考卷*/
问题电芯图片汇总/

# ---------- 数据闭环产出（收割 / 复核结果，图片量大） ----------
收割结果_*/
复核_*/

# ---------- 大体积 CSV 记录（收割明细，可重新生成） ----------
harvest_*.csv
battlefield_*.csv

# ---------- 模型权重（*.pt 一律不入库） ----------
*.pt
*.onnx
*.engine
*.tflite


# ---------- 便携 Python 运行环境（~8 GB，严禁入库） ----------
runtime/

# ---------- 第三方工具安装包 ----------
tools/*.exe

# ---------- 运行期产物 ----------
logs/
web/results/
web/uploads/

# ---------- 汇报材料中的图片/媒体（保留 md 文档，排除媒体） ----------
ppt汇报/media/
ppt汇报/pages/
ppt汇报/screenshots/
ppt汇报_screenshot/
向上汇报/pages/
向上汇报_screenshot/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------- 系统/编辑器 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# ---------- 评估临时集（硬链接，可重建） ----------
.cache/
# ---------- 重划分后的数据集（硬链接，可重建） ----------
datasets_v5/

# ---------- 复核脚本的写前备份与操作清单（本地可回滚，不入库） ----------
_backup/

# ---------- 复核产出：staging（图片副本 + 合并标记，由脚本重新生成） ----------
待微调_V4捡漏/

# ---------- ROI 裁剪数据集（由母本 + core/roi.py 可重建；含 5GB 图像缓存） ----------
datasets_v51/

# ---------- 本地 Agent 记忆与工作数据 ----------
.workbuddy/

# ---------- ultralytics 训练时自建的图像缓存（可重建） ----------
runs/**/*.npy

# ---------- 训练日志的临时文件（结束时归位为 <run>/train.log，Windows 上句柄未关会残留） ----------
runs/detect/CT_pro/_*.train.log
